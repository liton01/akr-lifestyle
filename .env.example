# ─────────────────────────────────────────────────────────────
# AKR Lifestyle — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/akrlifestyle?schema=public"
# Separate database used by integration tests (it is wiped by the test runner)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/akrlifestyle_test?schema=public"

# Public base URL of the site (used for links in emails and payment callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3100"
# Require customers to verify their email before signing in (needs a working email provider)
AUTH_REQUIRE_EMAIL_VERIFICATION="false"
# Extra trusted origins, comma separated (optional)
TRUSTED_ORIGINS=""

# First administrator — used by `npm run admin:create` and the seed script.
# Use a unique password of at least 12 characters. Remove it from the environment after bootstrapping.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Store Administrator"

# File storage: "local" (development only) or "s3" (any S3-compatible service: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage/uploads"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves the bucket, e.g. https://cdn.example.com
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"

# Email: "console" (logs to server output, nothing is delivered) or "smtp"
EMAIL_PROVIDER="console"
EMAIL_FROM="AKR Lifestyle <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Recipient for staff alerts (new orders, low stock, contact form)
STORE_NOTIFICATION_EMAIL=""

# SMS: "none" or "http" (generic JSON HTTP gateway — see docs/INTEGRATIONS.md)
SMS_PROVIDER="none"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# SSLCommerz online payments. Leave empty to disable online payment.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
# "true" uses https://sandbox.sslcommerz.com, "false" uses the live gateway
SSLCOMMERZ_SANDBOX="true"

# Secret for the scheduled maintenance endpoint (/api/cron/maintenance)
CRON_SECRET="replace-with-a-long-random-secret"
